# Copy to .env and fill in credentials. See README.md for details.

# OpenAI-compatible LLM endpoint for the agent (ask/chat).
#   OpenAI:    leave OPENAI_BASE_URL unset, set OPENAI_API_KEY
#   Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1   (no key needed)
#   LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1    (no key needed)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Model name the agent requests - set to whatever your endpoint serves.
I2A_MODEL=gpt-4o

# Internet2 Periscope MCP endpoint (public, no credentials currently required).
PERISCOPE_MCP_URL=https://periscope.ns.internet2.edu/mcp

# Future Internet2/Periscope auth token. Leave blank while the server is open.
PERISCOPE_AUTH_TOKEN=
